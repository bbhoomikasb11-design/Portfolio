{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|images/|fonts/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/projects",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/playground",
      "destination": "/#playground",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/#experience",
      "permanent": true
    },
    {
      "source": "/education",
      "destination": "/#education",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#background",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#connect",
      "permanent": true
    },
    {
      "source": "/projects/safescan",
      "destination": "/#project-safescan",
      "permanent": true
    },
    {
      "source": "/projects/campusmesh",
      "destination": "/#project-campusmesh",
      "permanent": true
    },
    {
      "source": "/projects/adaptui",
      "destination": "/#project-adaptui",
      "permanent": true
    },
    {
      "source": "/projects/clearhead",
      "destination": "/#project-clearhead",
      "permanent": true
    }
  ]
}
